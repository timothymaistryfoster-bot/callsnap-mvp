# Your OpenAI API key (required)
OPENAI_API_KEY=""

# Cost mode
OPENAI_CHEAP_MODE="true"

# Cheap mode model overrides (used when OPENAI_CHEAP_MODE=true)
OPENAI_CHEAP_TRANSCRIBE_MODEL="whisper-1"
OPENAI_CHEAP_SUMMARY_MODEL="gpt-4.1-mini"

# Standard model settings (used when OPENAI_CHEAP_MODE=false)
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_SUMMARY_MODEL="gpt-4.1-mini"
MAX_SUMMARY_OUTPUT_TOKENS="700"

# Cost guardrails
MAX_AUDIO_FILE_MB="20"
MAX_TRANSCRIPT_CHARS="45000"
CALL_SUMMARY_RATE_LIMIT_PER_HOUR="15"
AUTO_STOP_ON_LARGE_TRANSCRIPT="true"
