# Your OpenAI API key (required)
OPENAI_API_KEY=""

# Models — defaults are set, only change if you want to experiment
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_SUMMARY_MODEL="gpt-4.1-mini"

# Cost guardrails
MAX_AUDIO_FILE_MB="20"
MAX_TRANSCRIPT_CHARS="45000"
CALL_SUMMARY_RATE_LIMIT_PER_HOUR="15"
